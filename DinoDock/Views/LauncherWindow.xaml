<Window x:Class="DinoDock.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DinoDock.ViewModels"
        Title="DinoDock"
        Icon="/Assets/AppIcon.ico"
        Width="700" Height="550"
        MinWidth="560" MinHeight="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Custom dark title bar: WindowChrome keeps native drag, resize, snap and Aero Shake. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <!-- Prehistoric night scene, anchored to the bottom so the ground stays put when resizing. -->
            <Grid.Background>
                <ImageBrush ImageSource="/Assets/LauncherBackground.jpg" Stretch="UniformToFill"
                            AlignmentX="Center" AlignmentY="Bottom" />
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/AppLogo.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DinoDock" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE921;" Width="36" FontSize="10"
                            ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="OnMinimizeClick" IsTabStop="False" />
                    <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;" Width="36" FontSize="10" Margin="2,0,0,0"
                            ToolTip="Close" AutomationProperties.Name="Close" Click="OnCloseClick" IsTabStop="False" />
                </StackPanel>
            </Grid>

            <!-- Header + cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel VerticalAlignment="Center" Margin="24,8,24,16">
                    <!-- 3D logo (rendered in Blender) with claw marks torn through it -->
                    <Image Source="/Assets/DinoDockTitle.png" Height="58" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="DinoDock" />
                    <TextBlock Text="YOUR  FLOATING  WEB  COMPANION" FontSize="11.5" FontWeight="Bold" Margin="0,10,0,0"
                               Foreground="#9BEA82" HorizontalAlignment="Center" />

                    <ItemsControl x:Name="CardsList" ItemsSource="{Binding Apps}" Margin="0,30,0,0" HorizontalAlignment="Center"
                                  Focusable="False"
                                  KeyboardNavigation.TabNavigation="Continue"
                                  KeyboardNavigation.DirectionalNavigation="Cycle">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AppCardViewModel}">
                                <Button Style="{StaticResource AppCardStyle}"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding App.Name}"
                                        AutomationProperties.HelpText="{Binding App.Description}">
                                    <Grid>
                                        <!-- "Last used" badge -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                                CornerRadius="8" Padding="7,2" Background="#1FFFFFFF"
                                                Visibility="{Binding IsLastUsed, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Last used" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,8,12,0">
                                            <!-- Icon tile: built-in glyph, or Assets/Icons/{id}.png if supplied -->
                                            <Border Width="60" Height="60" CornerRadius="16" Background="{Binding App.TileBrush}"
                                                    HorizontalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.3" Color="Black" />
                                                </Border.Effect>
                                                <Grid>
                                                    <Path Data="{Binding App.IconGeometry}" Fill="White" Stretch="Uniform"
                                                          Width="32" Height="32"
                                                          Visibility="{Binding App.HasGlyph, Converter={StaticResource BoolToVisibility}}" />
                                                    <Image Source="{Binding App.IconImage}" Width="38" Height="38"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding App.HasIconImage, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding App.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                                       Margin="0,14,0,0" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding App.Description}" FontSize="12.5" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding App.DisplayHost}" FontSize="11" Margin="0,8,0,0"
                                                       Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: shortcut hints -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Border CornerRadius="5" Background="#1FFFFFFF" Padding="6,2">
                    <TextBlock Text="Ctrl+Shift+Space" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
                <TextBlock Text="show / hide player" FontSize="11" Margin="6,0,18,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}" />
                <Border CornerRadius="5" Background="#1FFFFFFF" Padding="6,2">
                    <TextBlock Text="Ctrl+Shift+P" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
                <TextBlock Text="keep on top" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
